# Root environment template. Copy to .env and fill in the real values.
# Used by infra/docker-compose.yml (compose is run from infra/).

# --- Frontend (web-app) ---
# Inlined into the browser bundle at BUILD time by Next.js, so the deploy
# pipeline passes these as build args (see infra/github-actions/cd.yml and
# apps/web-app/Dockerfile). The public origin of the web app, WITHOUT an
# /api suffix — api-core routes (e.g. /api/projects) live on the same origin
# behind the load balancer.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_API_URL=https://<your-web-app-origin>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# --- Backend (services/api-core) ---
# REQUIRED: the API refuses to boot without CLERK_ISSUER_URL and DATABASE_URL.
CLERK_ISSUER_URL=https://<yourapp>.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_...
CLERK_AUDIENCE=
DATABASE_URL="postgresql://elmahrosa:password@localhost:5432/elmahrosa?schema=public"
# Same-origin only when empty; set to the web-app origin for cross-origin calls.
ALLOWED_ORIGIN=https://<your-web-app-origin>
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Queue / generator services ---
ANTHROPIC_API_KEY=sk-ant-...
REDIS_URL=redis://redis:6379

# --- infra/docker-compose.yml ---
POSTGRES_PASSWORD=change-me